<properties>
   <jacoco-maven-plugin>0.8.6</jacoco-maven-plugin>
</properties>

<build>
 <plugins>
   <plugin>
     <groupId>org.jacoco</groupId>
     <artifactId>jacoco-maven-plugin</artifactId>
     <version>${jacoco-maven-plugin}</version>
     <executions>
       <execution>
         <goals>
           <goal>prepare-agent</goal>
         </goals>
       </execution>
       <execution>
         <id>report</id>
         <phase>prepare-package</phase>
         <goals>
           <goal>report</goal>
         </goals>
       </execution>
     </executions>
   </plugin>
 </plugins>
</build>
